generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RelationType {
  related
  alternative
  prerequisite
  advanced
  ecosystem
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  expert
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String?
  urls        Json?
  resources   Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profileSkills ProfileSkill[]
  relationsFrom SkillRelation[] @relation("SourceSkill")
  relationsTo   SkillRelation[] @relation("TargetSkill")

  @@index([category])
  @@map("skills")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profiles Profile[]
  settings UserSettings?

  @@map("users")
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  isMain           Boolean  @default(false) @map("is_main")
  basedOnProfileId String?  @map("based_on_profile_id")
  profileData      Json?    @map("profile_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  basedOnProfile  Profile? @relation("ProfileDerivation", fields: [basedOnProfileId], references: [id])
  derivedProfiles Profile[] @relation("ProfileDerivation")
  skills          ProfileSkill[]
  resumeProjects  ResumeProject[]

  @@index([userId])
  @@map("profiles")
}

model ProfileSkill {
  profileId        String     @map("profile_id")
  skillId          String     @map("skill_id")
  level            SkillLevel
  years            Float?
  highlight        Boolean    @default(false)
  displayCategory  String?    @map("display_category")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

model ResumeProject {
  id            String   @id @default(cuid())
  profileId     String   @map("profile_id")
  name          String   @default("My Resume")
  theme         String   @default("classic")
  font          String   @default("inter")
  spacing       String   @default("normal")
  sectionOrder  Json     @map("section_order")
  visibility    Json
  dividerStyle  String   @default("line") @map("divider_style")
  pageCount     Int      @default(1) @map("page_count")
  jsonLayout    Json     @map("json_layout")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("resume_projects")
}

model SkillRelation {
  id           String       @id @default(cuid())
  sourceId     String       @map("source_id")
  targetId     String       @map("target_id")
  relationType RelationType @map("relation_type")

  source Skill @relation("SourceSkill", fields: [sourceId], references: [id], onDelete: Cascade)
  target Skill @relation("TargetSkill", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@map("skill_relations")
}

model UserSettings {
  userId           String  @id @map("user_id")
  recentProfileIds Json    @default("[]") @map("recent_profile_ids")
  recentResumeIds  Json    @default("[]") @map("recent_resume_ids")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
